PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/transport_erp
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# First super admin login, created on startup if none exists. Change the password in the app afterwards.
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
VITE_GOOGLE_MAPS_API_KEY=replace-with-a-referrer-restricted-google-maps-browser-key
GPS_SPEED_ALERT_LIMIT_KMH=80
# Optional absolute path when MongoDB Database Tools are not available on PATH; required tools must be installed separately.
MONGODUMP_PATH=
